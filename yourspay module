<script>

/* =================================================
   EMPLOYEE CODE GENERATOR
================================================= */

function generateEmployeeCode() {

    let employees =
        JSON.parse(localStorage.getItem("employees")) || [];

    /*
       Find highest existing employee number.
       This prevents duplicate codes after deleting employees.
    */

    let highest = 0;

    employees.forEach(function(employee) {

        if (employee.code) {

            let match =
                employee.code.match(/YSP(\d+)/);

            if (match) {

                let number =
                    parseInt(match[1]);

                if (number > highest) {
                    highest = number;
                }

            }

        }

    });

    let nextNumber = highest + 1;

    let code =
        "YSP" +
        String(nextNumber).padStart(4,"0");

    document.getElementById("employeeCode").value =
        code;
}


/* =================================================
   SALARY CALCULATION
================================================= */

function calculateSalary() {

    let basic =
        parseFloat(
            document.getElementById("basic").value
        ) || 0;


    let hra =
        parseFloat(
            document.getElementById("hra").value
        ) || 0;


    let incentive =
        parseFloat(
            document.getElementById("Incentive").value
        ) || 0;


    let other =
        parseFloat(
            document.getElementById("otherAllowance").value
        ) || 0;


    let pf =
        parseFloat(
            document.getElementById("pf").value
        ) || 0;


    let esi =
        parseFloat(
            document.getElementById("esi").value
        ) || 0;


    let payDays =
        parseFloat(
            document.getElementById("payDays").value
        ) || 0;


    let paidDays =
        parseFloat(
            document.getElementById("paidDays").value
        ) || 0;


    let lop =
        parseFloat(
            document.getElementById("lop").value
        ) || 0;


    /*
       Gross Salary
    */

    let gross =
        basic +
        hra +
        incentive +
        other;


    /*
       Daily Salary
    */

    let dailySalary =
        payDays > 0
        ? gross / payDays
        : 0;


    /*
       LOP Deduction
    */

    let lopAmount =
        dailySalary * lop;


    /*
       Total Deduction
    */

    let totalDeduction =
        pf +
        esi +
        lopAmount;


    /*
       Net Salary
    */

    let netSalary =
        gross -
        totalDeduction;


    /*
       Display
    */

    document.getElementById("grossSalary").innerText =
        formatCurrency(gross);


    document.getElementById("totalDeduction").innerText =
        formatCurrency(totalDeduction);


    document.getElementById("lopAmount").innerText =
        formatCurrency(lopAmount);


    document.getElementById("netSalary").innerText =
        formatCurrency(netSalary);
}


/* =================================================
   CURRENCY FORMAT
================================================= */

function formatCurrency(amount) {

    return new Intl.NumberFormat(
        "en-IN",
        {
            style:"currency",
            currency:"INR",
            maximumFractionDigits:2
        }
    ).format(
        parseFloat(amount) || 0
    );
}


/* =================================================
   SAVE EMPLOYEE
================================================= */

function saveEmployee() {

    calculateSalary();


    let employee = {

        code:
            document.getElementById("employeeCode").value,

        name:
            document.getElementById("employeeName").value,

        designation:
            document.getElementById("designation").value,

        department:
            document.getElementById("department").value,

        payDate:
            document.getElementById("payDate").value,

        branch:
            document.getElementById("branch").value,

        reportingPerson:
            document.getElementById("reportingPerson").value,

        reportingDesignation:
            document.getElementById("reportingDesignation").value,

        grade:
            document.getElementById("grade").value,

        payDays:
            document.getElementById("payDays").value,

        paidDays:
            document.getElementById("paidDays").value,

        lop:
            document.getElementById("lop").value,

        basic:
            document.getElementById("basic").value,

        hra:
            document.getElementById("hra").value,

        incentive:
            document.getElementById("Incentive").value,

        otherAllowance:
            document.getElementById("otherAllowance").value,

        pf:
            document.getElementById("pf").value,

        esi:
            document.getElementById("esi").value,

        gross:
            document.getElementById("grossSalary").innerText,

        totalDeduction:
            document.getElementById("totalDeduction").innerText,

        lopAmount:
            document.getElementById("lopAmount").innerText,

        net:
            document.getElementById("netSalary").innerText

    };


    if (!employee.name.trim()) {

        alert(
            "Please enter Employee Name."
        );

        return;
    }


    let employees =
        JSON.parse(
            localStorage.getItem("employees")
        ) || [];


    /*
       Check if editing
    */

    let form =
        document.getElementById("payrollForm");

    let editIndex =
        form.dataset.editIndex;


    if (
        editIndex !== undefined &&
        editIndex !== ""
    ) {

        employees[
            parseInt(editIndex)
        ] = employee;


        delete form.dataset.editIndex;


        alert(
            "Employee updated successfully."
        );

    } else {

        employees.push(employee);


        alert(
            "Employee saved successfully."
        );

    }


    localStorage.setItem(
        "employees",
        JSON.stringify(employees)
    );


    loadEmployees();

    resetForm();
}


/* =================================================
