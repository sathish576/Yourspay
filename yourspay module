/* =================================================
   DELETE EMPLOYEE
================================================= */

function deleteEmployee(index) {

    if (
        !confirm(
            "Are you sure you want to delete this employee?"
        )
    ) {

        return;
    }


    let employees =
        JSON.parse(
            localStorage.getItem("employees")
        ) || [];


    employees.splice(index,1);


    localStorage.setItem(
        "employees",
        JSON.stringify(employees)
    );


    loadEmployees();

    generateEmployeeCode();

}


