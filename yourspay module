<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Yourspay | Employee Payroll CRM</title>

<style>

:root {
    --primary:#0a2540;
    --accent:#00d4b2;
    --light:#f5f7fa;
    --white:#fff;
    --dark:#263238;
    --danger:#dc3545;
    --border:#d9e1e8;
    --warning:#ffc107;
}

/* =========================
   GENERAL
========================= */

* {
    box-sizing:border-box;
    margin:0;
    padding:0;
    font-family:Segoe UI,Arial,sans-serif;
}

body {
    background:var(--light);
    color:var(--dark);
}

.container {
    width:92%;
    max-width:1400px;
    margin:30px auto;
}

/* =========================
   NAVBAR
========================= */

nav {
    background:var(--primary);
    color:white;
    padding:16px 5%;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.logo {
    font-size:25px;
    font-weight:bold;
}

.logo span {
    color:var(--accent);
}

nav a {
    color:white;
    text-decoration:none;
    margin-left:20px;
}

/* =========================
   HEADER
========================= */

.header {
    background:linear-gradient(135deg,#0a2540,#164a78);
    color:white;
    padding:45px 5%;
}

.header h1 {
    margin-bottom:8px;
}

/* =========================
   CARD
========================= */

.card {
    background:white;
    padding:25px;
    border-radius:10px;
    box-shadow:0 4px 15px rgba(0,0,0,.08);
    margin-bottom:25px;
}

.card h2 {
    color:var(--primary);
    margin-bottom:20px;
    border-bottom:2px solid var(--accent);
    padding-bottom:10px;
}

/* =========================
   FORM
========================= */

.form-grid {
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:18px;
}

.form-group label {
    display:block;
    font-weight:600;
    margin-bottom:6px;
}

.form-group input,
.form-group select {
    width:100%;
    padding:11px;
    border:1px solid var(--border);
    border-radius:5px;
    font-size:15px;
}

.form-group input:focus,
.form-group select:focus {
    outline:none;
    border-color:var(--accent);
}

/* =========================
   EMPLOYEE CODE
========================= */

.employee-code {
    background:#e8fff9 !important;
    font-weight:bold;
    color:#008c78;
}

/* =========================
   SALARY
========================= */

.salary-box {
    background:#f8fafc;
    padding:20px;
    margin-top:25px;
    border-radius:8px;
}

.salary-grid {
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
}

.salary-item {
    background:white;
    padding:15px;
    border-radius:6px;
    border-left:4px solid var(--accent);
}

.salary-item strong {
    display:block;
    color:#666;
    font-size:13px;
}

.salary-item span {
    font-size:20px;
    font-weight:bold;
}

/* =========================
   BUTTONS
========================= */

.buttons {
    margin-top:25px;
    display:flex;
    gap:10px;
    flex-wrap:wrap;
}

button {
    border:none;
    padding:12px 22px;
    border-radius:5px;
    cursor:pointer;
    font-weight:bold;
}

.save-btn {
    background:var(--accent);
    color:var(--primary);
}

.reset-btn {
    background:#6c757d;
    color:white;
}

.print-btn {
    background:var(--primary);
    color:white;
}

.delete-btn {
    background:var(--danger);
    color:white;
    padding:7px 12px;
}

.edit-btn {
    background:var(--warning);
    color:#000;
    padding:7px 12px;
}

button:hover {
    opacity:.9;
}

/* =========================
   TABLE
========================= */

.table-wrapper {
    overflow-x:auto;
}

table {
    width:100%;
    border-collapse:collapse;
    min-width:1100px;
}

th {
    background:var(--primary);
    color:white;
    padding:12px;
    text-align:left;
}

td {
    padding:11px;
    border-bottom:1px solid #ddd;
}

tr:hover {
    background:#f8fafc;
}

/* =========================
   FOOTER
========================= */

footer {
    background:var(--primary);
    color:white;
    text-align:center;
    padding:20px;
    margin-top:40px;
}

/* =========================
   PRINT PAYROLL
========================= */

.print-payroll {
    display:none;
}

/* =========================
   RESPONSIVE
========================= */

@media(max-width:1000px) {

    .form-grid,
    .salary-grid {
        grid-template-columns:repeat(2,1fr);
    }

}

@media(max-width:600px) {

    .form-grid,
    .salary-grid {
        grid-template-columns:1fr;
    }

    nav {
        flex-direction:column;
        gap:15px;
    }

    nav div:last-child {
        text-align:center;
    }

}

/* =================================================
   PRINT ONLY EMPLOYEE PAYROLL SLIP
================================================= */

@media print {

    @page {
        size:A4;
        margin:15mm;
    }

    body {
        background:white !important;
    }

    body * {
        visibility:hidden;
    }

    #printPayroll,
    #printPayroll * {
        visibility:visible;
    }

    #printPayroll {
        display:block;
        position:absolute;
        left:0;
        top:0;
        width:100%;
        background:white;
        color:#000;
        padding:5px;
    }

    .print-header {
        text-align:center;
        border-bottom:2px solid #000;
        padding-bottom:15px;
        margin-bottom:20px;
    }

    .print-header h1 {
        font-size:28px;
        margin-bottom:5px;
    }

    .print-header p {
        font-size:14px;
    }

    .employee-details {
        display:grid;
        grid-template-columns:1fr 1fr;
        border:1px solid #000;
        margin-bottom:25px;
    }

    .employee-details div {
        padding:10px;
        border-bottom:1px solid #000;
    }

    .employee-details div:nth-child(odd) {
        border-right:1px solid #000;
    }

    .print-payroll h3 {
        margin-top:20px;
        margin-bottom:10px;
        border-bottom:1px solid #000;
        padding-bottom:7px;
    }

    .print-table {
        width:100%;
        border-collapse:collapse;
        min-width:0;
    }

    .print-table td {
        border:1px solid #000;
        padding:10px;
    }

    .print-table td:first-child {
        font-weight:500;
    }

    .print-table td:last-child {
        text-align:right;
    }

    .print-table .total {
        font-weight:bold;
    }

    .print-table .net {
        font-weight:bold;
        font-size:18px;
        border-top:2px solid #000;
    }

    .print-footer {
        margin-top:70px;
        display:flex;
        justify-content:space-between;
    }

    .print-footer div {
        text-align:center;
        width:40%;
    }

}

/* =================================================
   END PRINT
================================================= */

</style>
</head>

