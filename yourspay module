================================================= */

function loadEmployees() {

    let employees =
        JSON.parse(
            localStorage.getItem("employees")
        ) || [];


    let table =
        document.getElementById(
            "employeeTableBody"
        );


    table.innerHTML = "";


    employees.forEach(
        function(employee,index) {

            let row =
                document.createElement("tr");


            row.innerHTML = `

                <td>
                    <strong>
                        ${employee.code}
                    </strong>
                </td>

                <td>
                    ${escapeHTML(employee.name)}
                </td>

                <td>
